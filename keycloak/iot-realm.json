{
  "realm": "iot",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "dashboard-user" },
      { "name": "admin-user" },
      { "name": "controller-ingest" }
    ]
  },
  "users": [
    {
      "username": "testuser_norole",
      "enabled": true,
      "credentials": [
        {

          "type": "password",
          "value": "${IOTUSER01_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "iotuser01",
      "enabled": true,
      "credentials": [
        {
          
          "type": "password",
          "value": "${IOTUSER01_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["dashboard-user"]
    },    
    {
      "username": "admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["admin-user", "dashboard-user"]
    },
    {
      "username": "service-account-controller-client",
      "enabled": true,
      "serviceAccountClientId": "controller-client",
      "realmRoles": [
        "controller-ingest"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "dashboard-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://www.lab.local/*",
        "https://www.lab.local/",
        "https://local.kleber.data/*",
        "https://local.kleber.data/",
        "https://192.168.4.18/*",
        "https://192.168.4.18/"
      ],
      "webOrigins": [
        "+"
      ]
    },
    {
      "clientId": "controller-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${CONTROLLER_CLIENT_SECRET}"
    }
  ]
}
