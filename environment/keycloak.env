KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HTTP_RELATIVE_PATH=/auth
KC_HEALTH_ENABLED="true"
KC_HTTP_ENABLED="false"
KC_HTTPS_PORT=8443
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/certs/www_cert.cert
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/certs/www_key.key
KC_BASE_URL=http://localhost:8443/auth
KC_JWKS_URI=http://localhost:8443/auth/realms/iot/protocol/openid-connect/certs
KC_HOSTNAME=local.kleber.data