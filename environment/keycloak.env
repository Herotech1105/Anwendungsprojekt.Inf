KC_HTTPS_PORT=8443
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/certs/www_cert.cert
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/certs/www_key.key
KC_HOSTNAME=local.kleber.data