{
  "id": null,
  "title": "IoT Dashboard – Dark Mode",
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Requests (rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(api_requests_total[5m])",
          "legendFormat": "API Requests / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "DB Write Operations",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(db_write_operations_total[1h])",
          "legendFormat": "Writes / hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "DB Errors (rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(db_errors_total[5m])",
          "legendFormat": "DB Errors / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Node.js CPU Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[5m])",
          "legendFormat": "CPU User"
        },
        {
          "expr": "rate(process_cpu_system_seconds_total[5m])",
          "legendFormat": "CPU System"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Node.js Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Resident Memory"
        },
        {
          "expr": "process_virtual_memory_bytes",
          "legendFormat": "Virtual Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}
